datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String       @id @default(uuid())
  name        String
  email       String       @unique
  password    String
  predictions Prediction[]

  @@map("users")
}

model Prediction {
  id              String   @id @default(uuid())
  description     String?
  probability     Float
  classification  String
  createdAt       DateTime @default(now()) @map("created_at")
  starParams      Json     @map("star_params")
  candidateParams Json     @map("candidate_params")
  signalParams    Json     @map("signal_params")
  existingData    Boolean  @map("existing_data")
  userId          String   @map("user_id")

  user User @relation(fields: [userId], references: [id])

  @@map("predictions")
}
